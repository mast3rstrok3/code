{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "T3CODE_MOBILE_VERSION": "3.0.0"
      }
    },
    "fork": {
      "extends": "production",
      "env": {
        "T3CODE_EXPO_OWNER": "mast3rstrok3",
        "T3CODE_EAS_PROJECT_ID": "66e60b43-6b66-4b66-adfb-5c8a41d32924",
        "T3CODE_IOS_TEAM_ID": "7V8BA67W22",
        "T3CODE_IOS_BUNDLE_ID": "com.nightingaleai.code"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    }
  },
  "submit": {
    "testflight": {
      "extends": "production"
    },
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    },
    "fork": {
      "ios": {
        "appleTeamId": "7V8BA67W22",
        "appName": "Nightingale Code",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyId": "$EXPO_ASC_KEY_ID",
        "ascApiKeyIssuerId": "$EXPO_ASC_ISSUER_ID"
      }
    }
  }
}
